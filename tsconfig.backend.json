{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // H-07 (progressive strictness): strictNullChecks + noImplicitAny are enabled for
    // the backend even though the frontend tsconfig hasn't reached full strict yet.
    // The remaining strict family (noUnusedLocals etc.) is tracked as follow-up work.
    "strictNullChecks": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "backend/src/**/*",
    "backend/services/**/*",
    "server.ts",
    "src/utils/statutoryAccountingEngine.ts",
    "src/utils/procurementEngine.ts",
    "src/utils/productionEngine.ts",
    "src/utils/orderStateMachine.ts",
    "src/utils/rbacMatrix.ts"
  ],
  "exclude": ["node_modules", "dist", "supabase/functions", "src/backupcomponents"]
}